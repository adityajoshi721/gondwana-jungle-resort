# Create an EmailJS service and template, then set these in your hosting provider.
# Template variables: from_name, reply_to, phone, dates, guests, message, to_email.
# Route the template to the resort's verified inbox.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Public GA4 web stream measurement ID, not an API secret.
VITE_GA_MEASUREMENT_ID=

# Private Brevo settings for the updates signup Vercel Function.
# Never prefix these with VITE_ or put them in the browser bundle.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
